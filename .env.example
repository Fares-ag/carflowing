# Database (local Docker Postgres or Neon)
DATABASE_URL=postgresql://carflow:carflow@localhost:5432/carflow
# Role that migrations grant object ownership to. Defaults to the DATABASE_URL user.
# DATABASE_APP_ROLE=carflow
# db:seed and db:push refuse to run against a non-local database without this.
# NEVER set it against production: db:seed plants demo accounts with a published password.
# ALLOW_DESTRUCTIVE_SEED=true

# JWT secrets (change in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_2FA_SECRET=dev-2fa-secret-change-me-min-32-chars!!
COOKIE_SECURE=false
# HMAC key for stateless one-click unsubscribe links. Falls back to JWT_ACCESS_SECRET,
# so rotating the access secret invalidates every unsubscribe link already mailed.
# UNSUBSCRIBE_SECRET=
# Require TOTP for every admin/dealer staff login. Turning this on locks out staff
# who have not enrolled yet — enrol first, then flip.
# REQUIRE_STAFF_2FA=true
# Shared registrable domain for first-party auth cookies (production: .carflow.qa)
# When set, cookies use Domain=<value> + SameSite=Lax instead of SameSite=None.
# COOKIE_DOMAIN=.carflow.qa

# API
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
PUBLIC_API_URL=http://localhost:3001
CUSTOMER_APP_URL=http://localhost:5173
DEALER_APP_URL=http://localhost:5175
# Admin portal origin. Staff-invite and password-set emails link here — leave it
# unset in production and every invite mails a http://localhost:5174 link.
ADMIN_APP_URL=http://localhost:5174
# Proxy hops in front of Express (Vercel rewrite -> Railway edge = 2).
# Defaults: 2 in production, 1 elsewhere. Wrong value = rate limits keyed on a shared IP.
# TRUST_PROXY_HOPS=2
# Per-request access logging (default: off outside tests)
# ACCESS_LOG=true

# Content Security Policy (sent by the API for its own responses)
# Default policy: "default-src 'self'"; report-only unless CSP_ENFORCE=true.
# CONTENT_SECURITY_POLICY=default-src 'self'
# CSP_ENFORCE=true

# Observability (optional in dev; REQUIRED in production)
# Production boot refuses to start without SENTRY_DSN unless ALLOW_NO_ERROR_REPORTING=true.
# SENTRY_DSN=https://...
# ALLOW_NO_ERROR_REPORTING=true

# Uploads: local (dev) or blob (prod)
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
# BLOB_READ_WRITE_TOKEN=
# Vercel Blob visibility for non-identity uploads. Leave UNSET (private).
# BLOB_ACCESS=public is refused at production boot — identity documents would be
# world-readable via their blob URL.
# BLOB_ACCESS=

# Optional email (Resend) for password reset
# RESEND_API_KEY=
# FROM_EMAIL=noreply@carflow.dev

# Optional SMS verification (Twilio). Without these, non-production environments still
# accept SMS verification (codes logged server-side); production requires Twilio or
# SMS_VERIFICATION_ENABLED=true.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMS_VERIFICATION_ENABLED=true

# SkipCash payments
# Local / test: SKIPCASH_MODE=sandbox + sandbox merchant keys (see docs/PRODUCTION_READINESS.md)
# Production (Railway/host secrets only): SKIPCASH_MODE=production
SKIPCASH_MODE=sandbox
# Never paste real ids/keys into this file — earlier revisions did, and those values
# are now burned (see scripts/rotate-and-purge-secrets.md). Copy them from the SkipCash
# merchant portal into a gitignored .env (local) or host secrets (production).
# Sandbox (test portal)
# SKIPCASH_CLIENT_ID=<sandbox-client-id-from-skipcash-portal>
# SKIPCASH_KEY_ID=<sandbox-key-id-from-skipcash-portal>
# SKIPCASH_KEY_SECRET=<sandbox-key-secret-from-skipcash-portal>
# SKIPCASH_WEBHOOK_KEY=<sandbox-webhook-key-from-skipcash-portal>
# Production (www.carflow.qa portal) — set on host, not in local .env
# SKIPCASH_CLIENT_ID=<production-client-id-from-skipcash-portal>
# SKIPCASH_KEY_ID=<production-key-id-from-skipcash-portal>
# SKIPCASH_KEY_SECRET=<production-key-secret-from-skipcash-portal>
# SKIPCASH_WEBHOOK_KEY=<production-webhook-key-from-skipcash-portal>
# Portal webhook/return paths: /skipcash-pay/callback and /skipcash-pay/return
# SkipCash cannot POST to localhost — use deployed test host or HTTPS tunnel for webhook E2E
# SKIPCASH_REFUND_ENABLED=true
# Saved-card one-tap renewals (SkipCash tokenization — default off until charge is wired)
# SKIPCASH_SAVED_CARDS_ENABLED=false
# Set true only after createSkipCashPaymentWithToken is implemented in skipcash.ts
# SKIPCASH_SAVED_CARDS_CHARGE_READY=false

# WhatsApp transactional notifications (optional — select provider via WHATSAPP_PROVIDER)
# WHATSAPP_PROVIDER=meta
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_API_VERSION=v21.0
# WHATSAPP_META_LANGUAGE=en
# WHATSAPP_TEMPLATE_BOOKING_APPROVED=carflow_booking_approved
# WHATSAPP_TEMPLATE_INVOICE_DUE=carflow_invoice_due
# WHATSAPP_TEMPLATE_INVOICE_OVERDUE=carflow_invoice_overdue
# WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=carflow_payment_received
# WHATSAPP_PROVIDER=twilio
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# (reuses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN from SMS)

# Referral program store credit (QAR per party, applied to next invoice)
REFERRAL_CREDIT_AMOUNT_QAR=50

# Frontend (Vite reads from monorepo root)
# Production: set VITE_API_URL to your deployed API base including /api (required on Vercel)
# VITE_API_URL=https://api.carflow.qa/api
# Leave empty in local dev to use Vite proxy (/api -> localhost:3001)
# VITE_API_URL=
VITE_USE_MOCK_API=false

# --- Subscription billing engine (invygo/FINN-style monthly cycle) ---
# In-process jobs: invoice generation, dunning, webhook reconciliation,
# abandoned-hold cleanup. Safe on multiple instances (Postgres advisory lock).
# Production on Railway: leave true (default). Set false only with EXTERNAL_SCHEDULER=true.
ENABLE_JOBS=true
# EXTERNAL_SCHEDULER=true
JOBS_INTERVAL_MS=300000
# Days after the billing date before an unpaid invoice turns overdue (past_due).
BILLING_GRACE_DAYS=3
# Cancellation notice period (days); effective date lands on a billing boundary.
CANCEL_NOTICE_DAYS=30
# Days after handover before a customer may request a car swap.
SWAP_ELIGIBLE_DAYS=30
# Online-payment holds released if the payment doesn't complete in this window.
PAYMENT_HOLD_TTL_MINUTES=45
# Pending SkipCash payments older than this are reconciled against the provider.
PAYMENT_RECONCILE_AFTER_MINUTES=10
# Billing calendar timezone (IANA). Defaults to Asia/Qatar for invoice due/overdue sweeps.
# BILLING_TIMEZONE=Asia/Qatar
# Platform commission on subscription payments (0–1 decimal, default 0.1)
PLATFORM_COMMISSION_RATE=0.1
# Refundable deposit added to first invoice (keep 0 until refund flow ships)
SUBSCRIPTION_DEPOSIT_AMOUNT=0
# Concurrent unpaid checkout holds a single customer may hold open (default 3).
# MAX_ACTIVE_HOLDS_PER_CUSTOMER=3
# Unpaid SkipCash intent lifetime before it is terminated locally (default 60).
# Keep above PAYMENT_HOLD_TTL_MINUTES so the hold job gets first refusal.
# PAYMENT_INTENT_TTL_MINUTES=60
# Dealer payout batching: minimum pending balance (QAR) and minimum gap between
# batches for one dealer. Defaults 100 / 24 — below these the sweep mints no payout.
# PAYOUT_MIN_BATCH_QAR=100
# PAYOUT_MIN_INTERVAL_HOURS=24
# Invoices touched per reminder sweep (default 5000).
# INVOICE_REMINDER_MAX_PER_SWEEP=5000

# --- Email outbox pacing / data retention (all optional; defaults shown) ---
# EMAIL_MARKETING_DELAY_MS=60000
# EMAIL_MARKETING_DRAIN_SHARE=0.4
# EMAIL_OUTBOX_RETENTION_DAYS=30
# AUTH_ARTIFACT_RETENTION_DAYS=30
# ANALYTICS_EVENT_RETENTION_DAYS=400
# ANALYTICS_ROLLUP_BACKFILL_MAX_DAYS=30
# RETENTION_SWEEP_INTERVAL_MS=21600000

# --- Process lifecycle (Railway) ---
# Boot retries before the instance gives up and Railway restarts it (default 8).
# BOOT_MAX_ATTEMPTS=8
# In-flight request drain window on SIGTERM, ms (default 15000).
# SHUTDOWN_TIMEOUT_MS=15000

# --- Ops scripts (never committed; export in the shell that runs the script) ---
# scripts/create-production-dealer.mjs — both are REQUIRED, it exits 1 without them.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# DEALER_EMAIL=
# DEALER_PASSWORD=
# DEALER_NAME=Prime Auto Group
# apps/backend bootstrap:admin
# CREATE_ADMIN_EMAIL=
# CREATE_ADMIN_NAME=
# CREATE_ADMIN_PASSWORD=

# --- Playwright E2E (optional) ---
# SkipCash staging flow: requires deployed API with sandbox keys + reachable webhook URL
# E2E_SKIP_CASH_STAGING=1
# E2E_STAGING_API_URL=https://api.test.carflow.example.com
# E2E_STAGING_CUSTOMER_URL=https://customer.test.carflow.example.com
# E2E_SKIP_CASH_WEBHOOK_KEY=<must match staging SKIPCASH_WEBHOOK_KEY>
