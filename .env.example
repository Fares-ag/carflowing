# Database (local Docker Postgres or Neon)
DATABASE_URL=postgresql://carflow:carflow@localhost:5432/carflow

# JWT secrets (change in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
COOKIE_SECURE=false

# API
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
PUBLIC_API_URL=http://localhost:3001
CUSTOMER_APP_URL=http://localhost:5173

# Uploads: local (dev) or blob (prod)
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
# BLOB_READ_WRITE_TOKEN=

# Optional email (Resend) for password reset
# RESEND_API_KEY=
# FROM_EMAIL=noreply@carflow.dev

# SkipCash payments
# Local / test: SKIPCASH_MODE=sandbox + sandbox merchant keys (see docs/PRODUCTION_READINESS.md)
# Production (Fly/host secrets only): SKIPCASH_MODE=production
SKIPCASH_MODE=sandbox
# Sandbox (test.carflow.4livedemo.com portal)
# SKIPCASH_CLIENT_ID=f68772da-eb04-4458-a667-34e86e574fe0
# SKIPCASH_KEY_ID=ce487912-1950-40d6-86e3-ad295e1b3e34
# SKIPCASH_KEY_SECRET=
# SKIPCASH_WEBHOOK_KEY=
# Production (www.carflow.qa portal) — set on host, not in local .env
# SKIPCASH_CLIENT_ID=d708480d-b1ca-4792-9c67-5bee32821072
# SKIPCASH_KEY_ID=b9bbdbce-d0e3-4a37-9e35-3fc07581df51
# SKIPCASH_KEY_SECRET=
# SKIPCASH_WEBHOOK_KEY=
# Portal webhook/return paths: /skipcash-pay/callback and /skipcash-pay/return
# SkipCash cannot POST to localhost — use deployed test host or HTTPS tunnel for webhook E2E
# SKIPCASH_REFUND_ENABLED=true

# Frontend (Vite reads from monorepo root)
# Leave empty to use Vite proxy (/api -> localhost:3001)
# VITE_API_URL=
VITE_USE_MOCK_API=false
